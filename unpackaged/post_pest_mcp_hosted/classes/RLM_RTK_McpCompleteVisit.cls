/** Verdant hosted MCP tool complete_visit. */
public with sharing class RLM_RTK_McpCompleteVisit {
    public class Request {
        @InvocableVariable(label='Visit' description='The visit: a work order Id or service appointment Id from get_my_schedule.' required=true)
        public String visit;
    }

    @InvocableMethod(label='Verdant: Complete visit' description='Completes the visit. Completing the first treatment starts the guarantees and the maintenance visit schedule from the customer\'s plans.' category='Verdant Field Assistant')
    public static List<RLM_RTK_McpTool.Response> run(List<Request> requests) {
        List<Map<String, Object>> params = new List<Map<String, Object>>();
        for (Request r : requests) {
            params.add(new Map<String, Object>{ 'recordId' => r.visit });
        }
        return RLM_RTK_McpTool.callEach('completeVisit', params);
    }
}

<?xml version="1.0" encoding="UTF-8"?>
<LightningComponentBundle xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>66.0</apiVersion>
    <isExposed>true</isExposed>
    <masterLabel>Brightline Refrigerant Log</masterLabel>
    <description>Work Order action (Field Service app) to log refrigerant added to a site's rooftop units with the annualized leak rate; on Asset, the unit's leak rate, compliance and history</description>
    <targets>
        <target>lightning__RecordAction</target>
        <target>lightning__RecordPage</target>
    </targets>
    <targetConfigs>
        <targetConfig targets="lightning__RecordAction">
            <actionType>ScreenAction</actionType>
        </targetConfig>
        <targetConfig targets="lightning__RecordPage">
            <objects>
                <object>Asset</object>
            </objects>
        </targetConfig>
    </targetConfigs>
</LightningComponentBundle>

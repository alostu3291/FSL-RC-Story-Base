    <localTopicLinks>
        <genAiPluginName>RLM_RTK_Pest_Bill_Questions</genAiPluginName>
    </localTopicLinks>
    <localTopics>
        <fullName>RLM_RTK_Pest_Bill_Questions</fullName>
        <aiPluginUtterances>
            <developerName>utterance1</developerName>
            <language xsi:nil="true"/>
            <masterLabel>utterance 1</masterLabel>
            <utterance>Why is my bill $366?</utterance>
        </aiPluginUtterances>
        <aiPluginUtterances>
            <developerName>utterance2</developerName>
            <language xsi:nil="true"/>
            <masterLabel>utterance 2</masterLabel>
            <utterance>Sam Patel is asking what the $196.90 charge is for.</utterance>
        </aiPluginUtterances>
        <aiPluginUtterances>
            <developerName>utterance3</developerName>
            <language xsi:nil="true"/>
            <masterLabel>utterance 3</masterLabel>
            <utterance>Explain this customer's latest bill.</utterance>
        </aiPluginUtterances>
        <aiPluginUtterances>

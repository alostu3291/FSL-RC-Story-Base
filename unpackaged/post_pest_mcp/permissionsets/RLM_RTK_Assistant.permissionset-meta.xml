    <label>RLM Verdant Field Assistant</label>
    <classAccesses>
        <apexClass>RLM_RTK_Assistant</apexClass>
        <enabled>true</enabled>
    </classAccesses>
    <classAccesses>
        <apexClass>RLM_RTK_AssistantApi</apexClass>
        <enabled>true</enabled>
    </classAccesses>
    <classAccesses>
        <apexClass>RLM_RTK_DemoReset</apexClass>
        <enabled>true</enabled>
    </classAccesses>
    <fieldPermissions>
        <editable>true</editable>
        <field>Account.RLM_RTK_Demo_Run__c</field>
        <readable>true</readable>
    </fieldPermissions>
</PermissionSet>

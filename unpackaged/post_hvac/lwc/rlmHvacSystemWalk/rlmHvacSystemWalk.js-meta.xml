<?xml version="1.0" encoding="UTF-8"?>
<LightningComponentBundle xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>66.0</apiVersion>
    <isExposed>true</isExposed>
    <masterLabel>Brightline System Check</masterLabel>
    <description>Equipment-by-equipment system check with findings, data plates, readings and photos that drive the comfort agreement recommendation</description>
    <targets>
        <target>lightning__FlowScreen</target>
    </targets>
    <targetConfigs>
        <targetConfig targets="lightning__FlowScreen">
            <property name="assessmentId" type="String" label="System Check Id" role="inputOnly"/>
            <property name="accountName" type="String" label="Account Name" role="inputOnly"/>
            <property name="serviceAddress" type="String" label="Service Address" role="inputOnly"/>
            <property name="planSku" type="String" label="Recommended Agreement SKU" role="outputOnly"/>
            <property name="recommendationJson" type="String" label="Recommendation JSON" role="outputOnly"/>
            <property name="findingCount" type="Integer" label="Finding Count" role="outputOnly"/>
        </targetConfig>
    </targetConfigs>
</LightningComponentBundle>

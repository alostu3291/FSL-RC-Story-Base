<?xml version="1.0" encoding="UTF-8"?>
<LightningComponentBundle xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>66.0</apiVersion>
    <isExposed>true</isExposed>
    <masterLabel>Brightline Service Checklist</masterLabel>
    <description>Technician checklist on a Work Order: standard tune-up steps for the system type with readings, then system check findings with before photos, repair status, notes and after photos</description>
    <targets>
        <target>lightning__FlowScreen</target>
        <target>lightning__RecordPage</target>
    </targets>
    <targetConfigs>
        <targetConfig targets="lightning__FlowScreen">
            <property name="workOrderId" type="String" label="Work Order Id" role="inputOnly"/>
        </targetConfig>
        <targetConfig targets="lightning__RecordPage">
            <objects>
                <object>WorkOrder</object>
            </objects>
        </targetConfig>
    </targetConfigs>
</LightningComponentBundle>
